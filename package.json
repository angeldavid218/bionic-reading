{
  "name": "smart-reading",
  "version": "1.0.0",
  "description": "Smart Reading is a tool that helps you read faster and easier by using a technique called 'chunking'.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest --run --reporter verbose --globals",
    "dev": "tsx src/index.ts",
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angeldavid218/smart-reading.git"
  },
  "keywords": [
    "bionic-reading",
    "reading",
    "speed",
    "reading-speed",
    "reading-technique",
    "reading-skills",
    "TDAH-reading"
  ],
  "author": "Angel Serrano",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/angeldavid218/smart-reading/issues"
  },
  "homepage": "https://github.com/angeldavid218/smart-reading#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.14",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "nodenext",
      "target": "esnext"
    }
  }
}
